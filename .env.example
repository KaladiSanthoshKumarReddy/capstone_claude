# ─── App ──────────────────────────────────────────────────────────────────────
FRONTEND_PORT=3000
BACKEND_PORT=4000
DATABASE_PATH=./data/capstone.db
JWT_SECRET=change-me-in-production

# ─── GitHub (Stage 8 – PR creation via gh CLI) ───────────────────────────────
GIT_REPO_URL=https://github.com/KaladiSanthoshKumarReddy/capstone_claude
GIT_BRANCH=main
GITHUB_TOKEN=ghp_your_github_token_here

# ─── Jira (Stage 1 – requirement sourcing via MCP) ───────────────────────────
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_PROJECT_KEY=CAP

# ─── Confluence (Stage 1 – wiki sourcing via MCP) ────────────────────────────
CONFLUENCE_BASE_URL=https://your-org.atlassian.net/wiki
CONFLUENCE_EMAIL=your-email@example.com
CONFLUENCE_API_TOKEN=your_confluence_api_token
CONFLUENCE_SPACE_KEY=CAP
